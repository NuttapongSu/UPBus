<!DOCTYPE html>
<html :class="{ 'theme-dark': dark }" x-data="data()" lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UP Bus - Evaluations</title>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/tailwind.output.css" />
    <link rel="icon" href="/assets/img/favicon.ico" type="image/x-icon">
    <script src="https://cdn.jsdelivr.net/gh/alpinejs/alpine@v2.x.x/dist/alpine.min.js" defer></script>
    <script src="/assets/js/init-alpine.js"></script>
    <style> body { font-family: 'Kanit', sans-serif !important; } </style>
</head>
<body>
    <div class="flex h-screen bg-gray-50 dark:bg-gray-900" :class="{ 'overflow-hidden': isSideMenuOpen }">
        <%- include('partials/sidebar', { page: 'evaluations' }) %>

        <div class="flex flex-col flex-1 w-full">
            <header class="z-10 py-4 bg-white shadow-md dark:bg-gray-800">
                <div class="container flex items-center justify-end h-full px-6 mx-auto text-purple-600 dark:text-purple-300">
                    <button class="rounded-md focus:outline-none focus:shadow-outline-purple" @click="toggleTheme" aria-label="Toggle color mode">
                        <template x-if="!dark"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg></template>
                        <template x-if="dark"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path></svg></template>
                    </button>
                </div>
            </header>

            <main class="h-full overflow-y-auto">
                <div class="container px-6 mx-auto grid">
                    <h2 class="my-6 text-2xl font-semibold text-gray-700 dark:text-gray-200">แบบประเมินความพึงพอใจ</h2>

                    <div class="grid gap-6 mb-8 md:grid-cols-2">
                        <div class="flex items-center p-4 bg-white rounded-lg shadow-xs dark:bg-gray-800">
                            <div class="p-3 mr-4 rounded-full" style="color: #be123c; background-color: rgba(190, 18, 60, 0.1);">
                                <svg class="w-5 h-5" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" stroke="currentColor">
                                    <path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">คะแนนเฉลี่ย (แอปพลิเคชัน)</p>
                                <p class="text-2xl font-semibold text-gray-700 dark:text-gray-200">
                                    <%= avgAppScore %> / 5.0
                                </p>
                                <span class="text-xs text-gray-500">จากผู้ประเมิน <%= totalApp %> คน</span>
                            </div>
                        </div>

                        <div class="flex items-center p-4 bg-white rounded-lg shadow-xs dark:bg-gray-800">
                            <div class="p-3 mr-4 rounded-full" style="color: #fcd34d; background-color: rgba(252, 211, 77, 0.1);">
                                <svg class="w-5 h-5" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" stroke="currentColor">
                                    <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">คะแนนเฉลี่ย (การเดินทาง)</p>
                                <p class="text-2xl font-semibold text-gray-700 dark:text-gray-200">
                                    <%= avgTravelScore %> / 5.0
                                </p>
                                <span class="text-xs text-gray-500">จากผู้ประเมิน <%= totalTravel %> คน</span>
                            </div>
                        </div>
                    </div>

                    <h4 class="mb-4 text-lg font-semibold text-gray-600 dark:text-gray-300 mt-8">
                        📱 ประเมินการใช้งานแอป (App Evaluations)
                    </h4>
                    <div class="w-full overflow-hidden rounded-lg shadow-xs mb-8">
                        <div class="w-full overflow-x-auto">
                            <table class="w-full whitespace-no-wrap">
                                <thead>
                                    <tr class="text-xs font-semibold tracking-wide text-left text-gray-500 uppercase border-b dark:border-gray-700 bg-gray-50 dark:text-gray-400 dark:bg-gray-800">
                                        <th class="px-4 py-3">วันที่</th>
                                        <th class="px-4 py-3 text-center">การบริการ (Service)</th>
                                        <th class="px-4 py-3 text-center">สถานะ (Status)</th>
                                        <th class="px-4 py-3 text-center">ประสิทธิภาพ (Efficiency)</th>
                                        <th class="px-4 py-3 text-center font-bold">เฉลี่ยรวม</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y dark:divide-gray-700 dark:bg-gray-800">
                                    <% if (appEvals.length > 0) { %>
                                        <% appEvals.forEach(function(item) { %>
                                            <tr class="text-gray-700 dark:text-gray-400">
                                                <td class="px-4 py-3 text-sm">
                                                    <%= new Date(item.created_at).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit' }) %>
                                                </td>
                                                <td class="px-4 py-3 text-center"><%= item.service_score %></td>
                                                <td class="px-4 py-3 text-center"><%= item.status_score %></td>
                                                <td class="px-4 py-3 text-center"><%= item.efficiency_score %></td>
                                                <td class="px-4 py-3 text-center font-bold text-green-600">
                                                    <%= ((item.service_score + item.status_score + item.efficiency_score) / 3).toFixed(1) %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="5" class="p-4 text-center">ไม่มีข้อมูล</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="grid px-4 py-3 text-xs font-semibold tracking-wide text-gray-500 uppercase border-t dark:border-gray-700 bg-gray-50 sm:grid-cols-9 dark:text-gray-400 dark:bg-gray-800">
                            <span class="flex items-center col-span-3">
                                แสดงหน้า <%= pagination.pageApp %> จาก <%= pagination.totalPageApp %>
                            </span>
                            <span class="col-span-2"></span>
                            <span class="flex col-span-4 mt-2 sm:mt-auto sm:justify-end">
                                <nav aria-label="Table navigation">
                                    <ul class="inline-flex items-center">
                                        <li>
                                            <a href="?pageApp=<%= pagination.pageApp > 1 ? pagination.pageApp - 1 : 1 %>&pageTravel=<%= pagination.pageTravel %>"
                                            class="px-3 py-1 rounded-md rounded-l-lg focus:outline-none focus:shadow-outline-purple" aria-label="Previous">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"></path></svg>
                                            </a>
                                        </li>
                                        
                                        <% for(let i=1; i <= pagination.totalPageApp; i++) { %>
                                        <li>
                                            <a href="?pageApp=<%= i %>&pageTravel=<%= pagination.pageTravel %>" 
                                            class="px-3 py-1 transition-colors duration-150 border border-r-0 border-purple-600 rounded-md focus:outline-none focus:shadow-outline-purple <%= pagination.pageApp == i ? 'bg-purple-600 text-white' : '' %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                        <li>
                                            <a href="?pageApp=<%= pagination.pageApp < pagination.totalPageApp ? pagination.pageApp + 1 : pagination.totalPageApp %>&pageTravel=<%= pagination.pageTravel %>"
                                            class="px-3 py-1 rounded-md rounded-r-lg focus:outline-none focus:shadow-outline-purple" aria-label="Next">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"></path></svg>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </span>
                        </div>
                    </div>

                    <h4 class="mb-4 text-lg font-semibold text-gray-600 dark:text-gray-300">
                        🚌 ประเมินการเดินทาง (Travel Evaluations)
                    </h4>
                    <div class="w-full overflow-hidden rounded-lg shadow-xs mb-8">
                        <div class="w-full overflow-x-auto">
                            <table class="w-full whitespace-no-wrap">
                                <thead>
                                    <tr class="text-xs font-semibold tracking-wide text-left text-gray-500 uppercase border-b dark:border-gray-700 bg-gray-50 dark:text-gray-400 dark:bg-gray-800">
                                        <th class="px-4 py-3">วันที่</th>
                                        <th class="px-4 py-3 text-center">ความสะดวก (Comfort)</th>
                                        <th class="px-4 py-3 text-center">เวลา (Time)</th>
                                        <th class="px-4 py-3 text-center">ความปลอดภัย (Safety)</th>
                                        <th class="px-4 py-3 text-center font-bold">เฉลี่ยรวม</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y dark:divide-gray-700 dark:bg-gray-800">
                                    <% if (travelEvals.length > 0) { %>
                                        <% travelEvals.forEach(function(item) { %>
                                            <tr class="text-gray-700 dark:text-gray-400">
                                                <td class="px-4 py-3 text-sm">
                                                    <%= new Date(item.created_at).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit' }) %>
                                                </td>
                                                <td class="px-4 py-3 text-center"><%= item.comfort_score %></td>
                                                <td class="px-4 py-3 text-center"><%= item.time_score %></td>
                                                <td class="px-4 py-3 text-center"><%= item.safety_score %></td>
                                                <td class="px-4 py-3 text-center font-bold text-green-600">
                                                    <%= ((item.comfort_score + item.time_score + item.safety_score) / 3).toFixed(1) %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="5" class="p-4 text-center">ไม่มีข้อมูล</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="grid px-4 py-3 text-xs font-semibold tracking-wide text-gray-500 uppercase border-t dark:border-gray-700 bg-gray-50 sm:grid-cols-9 dark:text-gray-400 dark:bg-gray-800">
                            <span class="flex items-center col-span-3">
                                แสดงหน้า <%= pagination.pageTravel %> จาก <%= pagination.totalPageTravel %>
                            </span>
                            <span class="col-span-2"></span>
                            <span class="flex col-span-4 mt-2 sm:mt-auto sm:justify-end">
                                <nav aria-label="Table navigation">
                                    <ul class="inline-flex items-center">
                                        <li>
                                            <a href="?pageApp=<%= pagination.pageApp %>&pageTravel=<%= pagination.pageTravel > 1 ? pagination.pageTravel - 1 : 1 %>"
                                            class="px-3 py-1 rounded-md rounded-l-lg focus:outline-none focus:shadow-outline-purple" aria-label="Previous">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"></path></svg>
                                            </a>
                                        </li>
                                        
                                        <% for(let i=1; i <= pagination.totalPageTravel; i++) { %>
                                        <li>
                                            <a href="?pageApp=<%= pagination.pageApp %>&pageTravel=<%= i %>" 
                                            class="px-3 py-1 transition-colors duration-150 border border-r-0 border-purple-600 rounded-md focus:outline-none focus:shadow-outline-purple <%= pagination.pageTravel == i ? 'bg-purple-600 text-white' : '' %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                        <li>
                                            <a href="?pageApp=<%= pagination.pageApp %>&pageTravel=<%= pagination.pageTravel < pagination.totalPageTravel ? pagination.pageTravel + 1 : pagination.totalPageTravel %>"
                                            class="px-3 py-1 rounded-md rounded-r-lg focus:outline-none focus:shadow-outline-purple" aria-label="Next">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"></path></svg>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </span>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>
</body>
</html>