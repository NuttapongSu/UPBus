{
  "expo": {
    "name": "UP Smart Transit",
    "slug": "upbus-mobile",
    "version": "1.2.2",
    "orientation": "portrait",
    "scheme": "upbus",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "th.ac.up.bustransit",
      "buildNumber": "13",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ใช้ตำแหน่งเพื่อหาป้ายรถใกล้คุณ",
        "NSCameraUsageDescription": "แอปขอใช้กล้องเพื่อถ่ายภาพประกอบการแจ้งปัญหา เช่น สภาพรถหรือพฤติกรรมคนขับ ในหน้าแจ้งเรื่องร้องเรียน",
        "NSPhotoLibraryUsageDescription": "แอปขอเข้าถึงคลังภาพเพื่อแนบรูปภาพประกอบการแจ้งปัญหาในหน้าแจ้งเรื่องร้องเรียน",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "up.ac.th_smarttransit",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAz2lobS3wNZdURKMyC1Dfvxc2BoefXLeo"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7c3aed"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ใช้ตำแหน่งเพื่อหาป้ายรถใกล้คุณ"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "แอปขอใช้กล้องเพื่อถ่ายภาพประกอบการแจ้งปัญหา เช่น สภาพรถหรือพฤติกรรมคนขับ ในหน้าแจ้งเรื่องร้องเรียน",
          "photosPermission": "แอปขอเข้าถึงคลังภาพเพื่อแนบรูปภาพประกอบการแจ้งปัญหาในหน้าแจ้งเรื่องร้องเรียน"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97135214-1cb4-4c69-8987-0d4bb9bd4909"
      }
    }
