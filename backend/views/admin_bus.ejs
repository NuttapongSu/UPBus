                    <h2 class="my-6 text-2xl font-semibold text-gray-700 dark:text-gray-200">
                        สถิติ
                    </h2>
                    <div class="grid gap-6 mb-8 md:grid-cols-2">
                        
                        <div class="min-w-0 p-4 bg-white rounded-lg shadow-xs dark:bg-gray-800">
                            <h4 class="mb-4 font-semibold text-gray-800 dark:text-gray-300">
                                สัดส่วนหัวข้อร้องเรียน
                            </h4>
                            <canvas id="pie"></canvas>
                            <div class="flex justify-center mt-4 space-x-3 text-sm text-gray-600 dark:text-gray-400">
                                <div class="flex items-center">
                                    <span class="inline-block w-3 h-3 mr-1 bg-blue-500 rounded-full"></span>
                                    <span>พฤติกรรมพนักงานขับ</span>
                                </div>
                                <div class="flex items-center">
                                    <span class="inline-block w-3 h-3 mr-1 bg-teal-600 rounded-full"></span>
                                    <span>อุปกรณ์รถชำรุด</span>
                                </div>
                                <div class="flex items-center">
                                    <span class="inline-block w-3 h-3 mr-1 bg-purple-600 rounded-full"></span>
                                    <span>ความขัดข้องของระบบ</span>
                                </div>
                            </div>
                        </div>

                        <div class="min-w-0 p-4 bg-white rounded-lg shadow-xs dark:bg-gray-800">
                            <h4 class="mb-4 font-semibold text-gray-800 dark:text-gray-300">
                                ยอดร้องเรียนรายเดือน (6 เดิอนล่าสุด)
                            </h4>
                            <canvas id="line"></canvas>
                            <div class="flex justify-center mt-4 space-x-3 text-sm text-gray-600 dark:text-gray-400">
                                <div class="flex items-center">
                                    <span class="inline-block w-3 h-3 mr-1 bg-blue-600 rounded-full"></span>
                                    <span>พฤติกรรม</span>
                                </div>
                                <div class="flex items-center">
                                    <span class="inline-block w-3 h-3 mr-1 bg-teal-600 rounded-full"></span>
                                    <span>อุปกรณ์</span>
                                </div>
                                <div class="flex items-center">
                                    <span class="inline-block w-3 h-3 mr-1 bg-purple-600 rounded-full"></span>
                                    <span>ระบบ</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2 class="my-6 text-2xl font-semibold text-gray-700 dark:text-gray-200">
                        ผลการประเมินความพึงพอใจ
                    </h2>

                    <div class="grid gap-6 mb-8 md:grid-cols-2">
                    <div class="flex items-center p-4 bg-white rounded-lg shadow-xs dark:bg-gray-800">
                        <div class="p-3 mr-4 rounded-full" 
                            style="color: #be123c; background-color: rgba(190, 18, 60, 0.1);"> 
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 2a8 8 0 100 16 8 8 0 000-16zM8 11a1 1 0 112 0 1 1 0 01-2 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">ผู้ประเมิน Application</p>
                            <p class="text-lg font-semibold text-gray-700 dark:text-gray-200"><%= evalData.totalApp %> คน</p>
                        </div>
                    </div>

                    <div class="flex items-center p-4 bg-white rounded-lg shadow-xs dark:bg-gray-800">
                        <div class="p-3 mr-4 rounded-full" 
                            style="color: #fcd34d; background-color: rgba(252, 211, 77, 0.1);">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
                            </svg>
                        </div>
                        <div>
                            <p class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">ผู้ประเมิน การเดินทาง</p>
                            <p class="text-lg font-semibold text-gray-700 dark:text-gray-200"><%= evalData.totalTravel %> คน</p>
                        </div>
                    </div>
                    </div>

                    <div class="min-w-0 p-4 mb-8 bg-white rounded-lg shadow-xs dark:bg-gray-800">
                        <h4 class="mb-4 font-semibold text-gray-800 dark:text-gray-300">คะแนนเฉลี่ย</h4>
                        <canvas id="evalBarChart"></canvas>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <script>
            const pieDataDB = JSON.parse('<%- JSON.stringify(locals.pieData || [0,0,0]) %>');
            const lineDataDB = JSON.parse('<%- JSON.stringify(locals.lineData || { labels: [], behavior: [], condition: [], system: [] }) %>');
            const evalDataDB = JSON.parse('<%- JSON.stringify(locals.evalData || { app: [0,0,0], travel: [0,0,0] }) %>');

        document.addEventListener('DOMContentLoaded', function () {
            
            // --- 1. Pie Chart ---
            const pieCtx = document.getElementById('pie');
            if (pieCtx) {
                new Chart(pieCtx, {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: pieDataDB, 
                            backgroundColor: ['#3b82f6', '#0d9488', '#7e3af2'],
                        }],
                        labels: ['พฤติกรรม', 'สภาพรถ', 'ระบบ'],
                    },
                    options: {
                        responsive: true,
                        cutoutPercentage: 80,
                        legend: { display: false },
                    }
                });
            }

            // --- 2. Line Chart ---
            const lineCtx = document.getElementById('line');
            if (lineCtx) {
                // เช็คก่อนวาดกราฟว่ามีข้อมูล labels ไหม
                const lineLabels = lineDataDB.labels || ['No Data'];
                
                new Chart(lineCtx, {
                    type: 'line',
                    data: {
                        labels: lineLabels, 
                        datasets: [
                            {
                                label: 'พฤติกรรม',
                                backgroundColor: '#3b82f6',
                                borderColor: '#3b82f6',
                                data: lineDataDB.behavior || [], 
                                fill: false,
                            },
                            {
                                label: 'สภาพรถ',
                                backgroundColor: '#0d9488',
                                borderColor: '#0d9488',
                                data: lineDataDB.condition || [], 
                                fill: false,
                            },
                            {
                                label: 'ระบบ',
                                backgroundColor: '#7e3af2',
                                borderColor: '#7e3af2',
                                data: lineDataDB.system || [], 
                                fill: false,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        legend: { display: false },
                        tooltips: { mode: 'index', intersect: false },
                        hover: { mode: 'nearest', intersect: true },
                        scales: {
                            yAxes: [{
                                ticks: { beginAtZero: true, stepSize: 1 }
                            }]
                        }
                    }
                });
            }
        });
    </script>
    <script>
      const evalConfig = {
        type: 'bar',
        data: {
            // ชื่อแกน X (3 อันแรกของ App, 3 อันหลังของ Travel)
            labels: [
                'App: การใช้บริการ', 'App: การแจ้งสถานะ', 'App: ประสิทธิภาพ', 
                'Travel: พฤติกรรมพนักงานขับรถ', 'Travel: เที่ยวรถรับ - ส่ง', 'Travel: ปัญหาและความปลอดภัย'
            ],
            datasets: [{
                label: 'คะแนนเฉลี่ย (เต็ม 5)',
                // กำหนดสี: 3 แท่งแรกสีฟ้า (App), 3 แท่งหลังสีเขียว (Travel)
                backgroundColor: [
                    '#be123c', '#be123c', '#be123c', 
                    '#fcd34d', '#fcd34d', '#fcd34d'
                ],
                borderWidth: 1,
                borderRadius: 4, // เพิ่มความโค้งมนให้แท่งกราฟดูสวยขึ้น
                
                // เทคนิค Spread Operator (...) เอาข้อมูล 2 ก้อนมาต่อกันเป็นก้อนเดียว
                data: [ ...evalDataDB.app, ...evalDataDB.travel ]
            }]
        },
        options: {
            responsive: true,
            // maintainAspectRatio: false, // เปิดบรรทัดนี้ถ้าอยากให้กราฟยืดเต็มความสูง div
            scales: {
                y: {
                    beginAtZero: true,
                    max: 5, // บังคับให้แกน Y สูงสุดที่เลข 5
                    ticks: {
                        stepSize: 1 // ให้โชว์สเกลทีละ 1 คะแนน
                    }
                },
                x: {
                    grid: {
                        display: false // ซ่อนเส้นตารางแนวตั้ง เพื่อความสะอาดตา
                    }
                }
            },
            plugins: {
                legend: {
                    display: false // ซ่อน Legend ด้านบน (เพราะสีแยกชัดเจนแล้ว)
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return 'คะแนนเฉลี่ย: ' + context.raw + ' / 5.0';
                        }
                    }
                }
            }
        }
    };

    // 2. สั่งวาดกราฟ (Render)
    const evalCanvas = document.getElementById('evalBarChart');
    if (evalCanvas) {
        const ctxBar = evalCanvas.getContext('2d');
        new Chart(ctxBar, evalConfig);
    }
    </script>
      
</body>
</html>