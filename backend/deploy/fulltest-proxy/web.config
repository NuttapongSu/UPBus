<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS Application web.config for the "bustransit-full test" proxy.
  Deploy target: a NEW IIS Application (its own Application Pool) added under
  the UPbustransit site with alias "fulltest", physical path pointing at the
  folder that holds this file (e.g. C:\UPbustransit-fulltest\fulltest-proxy).

  This proxies https://bustransit.up.ac.th/fulltest/* to the standalone
  full-test instance: backend on localhost:5002 (see
  backend/ecosystem.fulltest.config.json, backend/.env.fulltest.example) and
  frontend (Next.js) on localhost:3001. Mirrors the root web.config's
  backend/frontend path split (admin, login, api, uploads, etc. -> backend;
  everything else -> frontend), NOT the single-target gpstest-proxy pattern,
  since this instance has both a backend AND a frontend to route between.

  The frontend must be built with NEXT_BASE_PATH=/fulltest (see
  frontend/.env.fulltest.example) so Next.js's own routing/asset URLs come
  out already prefixed with /fulltest — that's why the frontend rewrite
  rules below re-add the /fulltest/ prefix when forwarding to localhost:3001,
  while the backend rules do NOT (Express has no basePath concept).

  Does not touch the production web.config, app pool, or the gpstest proxy.

  Known limitation: still goes through IIS ARR, so any SSE endpoint
  (GET /fulltest/api/gps/:id/stream) will not stream (ARR buffers the
  response) — same limitation as gpstest-proxy.
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <clear />

                <!-- 1. Backend Node.js — admin, login, get, api, uploads, etc. -->
                <rule name="NodeJS_Admin_API" stopProcessing="true">
                    <match url="^(admin|login|logout|complaints|evaluate|get|uploads|assets|public|css|js|img|favicon\.ico|api)(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="http://localhost:5002/{R:0}" />
                </rule>

                <!-- 2. Next.js frontend — root -->
                <rule name="NextJS_Root" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="http://localhost:3001/fulltest" />
                </rule>

                <!-- 3. Next.js frontend — catch-all (not a real file on disk) -->
                <rule name="NextJS_Frontend" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="http://localhost:3001/fulltest/{R:0}" />
                </rule>

            </rules>
        </rewrite>
        <proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" />
    </system.webServer>
</configuration>
