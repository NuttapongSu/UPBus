# Template for the "bustransit-full test" backend instance on the server --
# a complete, standalone copy of the full system (backend + frontend both),
# separate from both production (C:\UPbustransit) and the existing gpstest
# backend-only instance (C:\UPbustransit-test, port 5001).
#
# Purpose: exercise the real ESP32 <-> vendor hybrid GPS logic (buses.js'
# withEsp32PositionOverride) end-to-end on its own port/DB before it's
# trusted against the main production instance.
#
# Copy to backend/.env inside C:\UPbustransit-fulltest\backend and fill in
# real values there. Never commit the filled-in file.

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=db_bustransit_fulltest
PORT=5002
JWT_SECRET=
SESSION_SECRET=
USE_MOCK_GPS=true
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
LINE_USE_BROADCAST=
GPS_DEVICE_API_KEY=
