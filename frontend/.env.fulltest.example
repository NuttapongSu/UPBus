# Template for the "bustransit-full test" frontend instance -- a separate,
# standalone deployment folder (C:\UPbustransit-fulltest\frontend), NOT the
# same folder/build as production.
#
# IMPORTANT: Next.js only auto-loads a file literally named `.env.production`
# (when NODE_ENV=production, which `next build`/`next start` set by default).
# There is no ".env.fulltest" mechanism -- copy this file's contents into a
# `.env.production` file INSIDE the separate C:\UPbustransit-fulltest\frontend
# folder specifically (never overwrite the real production frontend's
# .env.production, which must keep pointing at the real domain). Then run
# `npm run build` inside that fulltest folder so these values get baked into
# the build output -- NEXT_PUBLIC_* vars are compiled in at build time, not
# read at runtime, so changing this file after a build has no effect until
# you rebuild.

NEXT_PUBLIC_API_URL=http://localhost:5002
NEXT_PUBLIC_ADMIN_URL=http://localhost:5002/admin/dashboard
